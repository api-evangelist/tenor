      "item": [
        {
          "id": "3f188bc8-6ec1-434d-983a-addf81f91715",
          "name": "Search GIFs and Stickers",
          "request": {
            "name": "Search GIFs and Stickers",
            "description": {
              "content": "Get a JSON object that contains a list of the most relevant GIFs or stickers for a given set of search terms, categories, emojis, or any combination of these.\n\nWhen you include the URL parameter `searchfilter=sticker` in the request, Tenor's search endpoint returns stickers rather than GIFs.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) API key for privileged access."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) A search string."
                },
                {
                  "disabled": false,
                  "key": "client_key",
                  "value": "<string>",
                  "description": "A client-specified string that represents the integration.\n\nThe client key lets you use the same API key across different integrations but still be able to differentiate them.\n\nFor an app integration, use the same `client_key` value for all API calls.\n"
                },
                {
                  "disabled": false,
                  "key": "searchfilter",
                  "value": "<string>",
                  "description": "Comma-separated list of non-GIF content types to filter the Response Objects.\n\nAccepted values are `sticker`, `static`, and `-static`.\n\n- `searchfilter=sticker` returns both static and animated sticker content.\n- `searchfilter=sticker,-static` returns only animated sticker content.\n- `searchfilter=sticker,static` returns only static sticker content.\n\nFor GIF content, either leave `searchfilter` blank or don't use it.\n"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "US",
                  "description": "Specify the country of origin for the request.\n\nProvide its two-letter ISO 3166-1 country code.\n"
                },
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "en_US",
                  "description": "Specify the default language to interpret the search string.\n\nFormat: `xx` or `xx_YY`, where `xx` is the ISO 639-1 language code and `YY` is the optional two-letter ISO 3166-1 country code.\n"
                },
                {
                  "disabled": false,
                  "key": "contentfilter",
                  "value": "false",
                  "description": "Specify the content safety filter level.\n\nAccepted values are `off`, `low`, `medium`, and `high`.\n\nThe default value is `off`.\n"
                },
                {
                  "disabled": false,
                  "key": "media_filter",
                  "value": "<string>",
                  "description": "Comma-separated list of GIF formats to filter the Response Objects.\n\nExample: `media_filter=gif,tinygif,mp4,tinymp4`.\n\nBy default, `media_filter` returns all formats for each Response Object.\n"
                },
                {
                  "disabled": false,
                  "key": "ar_range",
                  "value": "all",
                  "description": "Filter the Response Objects to only include GIFs with aspect ratios that fit within the selected range.\n\nAccepted values are:\n\n- `all`: No constraints (default)\n- `wide`: 0.42 <= aspect ratio <= 2.36\n- `standard`: 0.56 <= aspect ratio <= 1.78\n"
                },
                {
                  "disabled": false,
                  "key": "random",
                  "value": "false",
                  "description": "Specify whether to randomly order the response.\n\nAccepted values are `true` and `false`.\n\nThe default value is `false`.\n"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Fetch up to the specified number of results.\n\nThe default value is `20`, and the maximum value is `50`.\n"
                },
                {
                  "disabled": false,
                  "key": "pos",
                  "value": "<string>",
                  "description": "Retrieve results that start at the position \"value\".\n\nUse a non-zero, non-empty value from `next`, returned by the API response, to get the next set of results.\n\n`pos` isn't an index and might be an integer, float, or string.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
